# ==== App ====
NODE_ENV=development
PORT=4000

# ==== Database ====
# Local dev (docker-compose): postgresql://afya:afya@localhost:5432/afya_nyumbani
# Free hosted options: Supabase, Neon, Render Postgres — see README "Free Hosting" section
DATABASE_URL="postgresql://afya:afya@localhost:5432/afya_nyumbani"

# ==== Auth ====
# Generate strong random secrets in production, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# ==== Security ====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==== CORS ====
# Comma-separated list of allowed origins for the client apps
CORS_ORIGINS="http://localhost:3000"
