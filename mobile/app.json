{
  "expo": {
    "name": "Afya Nyumbani",
    "slug": "afya-nyumbani",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.afyanyumbani.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.afyanyumbani.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/wordmark.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "backgroundColor": "#EFE8E0"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "scheme": "afyanyumbani",
    "extra": {
      "apiUrl": "https://afya-nyumbani-api.onrender.com",
      "googleClientIds": {
        "web": "",
        "android": "",
        "ios": ""
      }
    }
  }
}
